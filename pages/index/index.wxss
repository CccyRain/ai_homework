page {
  background: #f5f6f8;
  color: #222;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 90rpx;
  box-sizing: border-box;
}


/* ==============================
   Header
   ============================== */

.header {
  padding: 25rpx 6rpx 35rpx;
}

.title {
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.subtitle {
  margin-top: 18rpx;
  color: #777;
  font-size: 27rpx;
  line-height: 1.7;
}


/* ==============================
   输入
   ============================== */

.input-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 34rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

.input-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 22rpx;
}

.goal-input {
  width: 100%;
  min-height: 240rpx;
  box-sizing: border-box;

  padding: 24rpx;

  background: #f7f8fa;

  border-radius: 20rpx;

  font-size: 29rpx;

  line-height: 1.7;
}

.start-button {
  width: 100%;

  margin-top: 25rpx;

  border-radius: 18rpx;

  font-size: 30rpx;

  font-weight: 600;
}


/* ==============================
   Loading
   ============================== */

.loading-card {
  margin-top: 28rpx;

  background: #fff;

  border-radius: 24rpx;

  padding: 30rpx;
}

.loading-title {
  font-size: 30rpx;

  font-weight: 600;
}

.loading-text {
  margin-top: 12rpx;

  color: #888;

  font-size: 25rpx;

  line-height: 1.6;
}


/* ==============================
   Error
   ============================== */

.error-card {
  margin-top: 28rpx;

  padding: 30rpx;

  background: #fff;

  border-radius: 24rpx;
}

.error-title {
  font-size: 30rpx;

  font-weight: 600;
}

.error-text {
  margin-top: 12rpx;

  color: #777;

  line-height: 1.6;
}

.retry-button {
  margin-top: 22rpx;
}


/* ==============================
   通用卡片
   ============================== */

.result-card {
  margin-top: 28rpx;

  background: #fff;

  border-radius: 26rpx;

  padding: 32rpx;

  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;

  font-weight: 650;
}

.card-description {
  margin-top: 12rpx;

  color: #888;

  font-size: 25rpx;

  line-height: 1.6;
}


/* ==============================
   Understanding
   ============================== */

.understanding {
  margin-top: 20rpx;

  font-size: 29rpx;

  line-height: 1.75;
}


/* ==============================
   建议
   ============================== */

.suggestion-item {
  display: flex;

  margin-top: 20rpx;

  font-size: 28rpx;

  line-height: 1.65;
}

.suggestion-dot {
  width: 12rpx;
  height: 12rpx;

  margin-top: 14rpx;

  margin-right: 18rpx;

  border-radius: 50%;

  background: #333;

  flex-shrink: 0;
}

.suggestion-text {
  flex: 1;
}


/* ==============================
   关键事项
   ============================== */

.important-item {
  display: flex;

  align-items: flex-start;

  margin-top: 22rpx;

  padding: 22rpx;

  border-radius: 18rpx;

  background: #f8f9fa;
}

.checkbox {
  width: 38rpx;
  height: 38rpx;

  margin-right: 18rpx;

  border: 2rpx solid #bbb;

  border-radius: 10rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  font-size: 24rpx;
}

.important-content {
  flex: 1;
}

.important-title {
  font-size: 29rpx;

  font-weight: 600;
}

.important-reason {
  margin-top: 8rpx;

  color: #888;

  font-size: 25rpx;

  line-height: 1.55;
}

.completed {
  opacity: 0.5;
}

.completed .important-title {
  text-decoration: line-through;
}


/* ==============================
   DDL
   ============================== */

.deadline-item {
  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 24rpx 0;

  border-bottom: 1rpx solid #eee;
}

.deadline-item:last-child {
  border-bottom: none;
}

.deadline-main {
  flex: 1;

  padding-right: 18rpx;
}

.deadline-title {
  font-size: 29rpx;

  font-weight: 600;
}

.deadline-date {
  margin-top: 8rpx;

  color: #888;

  font-size: 25rpx;

  line-height: 1.5;
}

.deadline-tag {
  padding: 7rpx 15rpx;

  border-radius: 20rpx;

  font-size: 22rpx;

  flex-shrink: 0;
}

.deadline-tag.high {
  background: #eee;

  color: #222;
}

.deadline-tag.medium {
  background: #f5f5f5;

  color: #555;
}

.deadline-tag.low {
  background: #fafafa;

  color: #888;
}


/* ==============================
   材料
   ============================== */

.material-item {
  display: flex;

  align-items: center;

  margin-top: 19rpx;

  font-size: 28rpx;

  line-height: 1.5;
}

.material-check {
  width: 38rpx;
  height: 38rpx;

  margin-right: 17rpx;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #f0f1f3;

  font-size: 22rpx;

  flex-shrink: 0;
}


/* ==============================
   Resource
   ============================== */

.resource-item {
  margin-top: 20rpx;

  padding: 22rpx;

  background: #f8f9fa;

  border-radius: 18rpx;
}

.resource-title {
  font-size: 29rpx;

  font-weight: 600;
}

.resource-description {
  margin-top: 8rpx;

  color: #888;

  font-size: 25rpx;

  line-height: 1.6;
}

.official-tag {
  display: inline-block;

  margin-top: 12rpx;

  padding: 6rpx 12rpx;

  background: #eee;

  border-radius: 10rpx;

  font-size: 21rpx;

  color: #555;
}


/* ==================================================
   ⭐ 我的倒推计划
   ================================================== */

.plan-card {
  margin-top: 32rpx;

  background: #fff;

  border-radius: 28rpx;

  padding: 34rpx;

  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

.plan-header {
  padding-bottom: 25rpx;

  border-bottom: 1rpx solid #eee;
}

.plan-title {
  font-size: 35rpx;

  font-weight: 700;
}

.plan-subtitle {
  margin-top: 10rpx;

  color: #888;

  font-size: 24rpx;
}


/* ==============================
   Stage
   ============================== */

.stage {
  position: relative;

  padding-top: 30rpx;

  padding-bottom: 12rpx;
}

.stage-header {
  display: flex;

  align-items: center;
}

.stage-number {
  width: 52rpx;
  height: 52rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #222;

  color: #fff;

  font-size: 25rpx;

  font-weight: 600;

  flex-shrink: 0;
}

.stage-info {
  margin-left: 18rpx;

  flex: 1;
}

.stage-name {
  font-size: 30rpx;

  font-weight: 650;
}

.stage-time {
  margin-top: 6rpx;

  color: #888;

  font-size: 24rpx;
}

.stage-goal {
  margin-top: 18rpx;

  padding: 18rpx;

  background: #f7f8fa;

  border-radius: 15rpx;

  color: #555;

  font-size: 25rpx;

  line-height: 1.55;
}

.stage-goal-label {
  font-weight: 600;

  color: #333;
}


/* ==============================
   Task
   ============================== */

.task-item {
  display: flex;

  align-items: flex-start;

  margin-top: 18rpx;

  padding: 19rpx;

  border-radius: 16rpx;

  background: #fafafa;
}

.task-checkbox {
  width: 36rpx;
  height: 36rpx;

  margin-right: 17rpx;

  border: 2rpx solid #bbb;

  border-radius: 9rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  font-size: 23rpx;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 27rpx;

  line-height: 1.5;
}

.task-description {
  margin-top: 6rpx;

  color: #999;

  font-size: 23rpx;

  line-height: 1.5;
}

.task-completed {
  opacity: 0.5;
}

.task-completed .task-title {
  text-decoration: line-through;
}


/* ==============================
   当前任务
   ============================== */

.current-card {
  margin-top: 32rpx;

  padding: 34rpx;

  background: #222;

  color: #fff;

  border-radius: 27rpx;

  box-shadow: 0 10rpx 35rpx rgba(0, 0, 0, 0.12);
}

.current-label {
  font-size: 26rpx;

  opacity: 0.7;
}

.current-text {
  margin-top: 17rpx;

  font-size: 34rpx;

  font-weight: 600;

  line-height: 1.6;
}


/* ==============================
   问题
   ============================== */

.question-card {
  margin-top: 28rpx;

  padding: 32rpx;

  background: #fff;

  border-radius: 26rpx;
}

.question-text {
  margin-top: 18rpx;

  font-size: 29rpx;

  line-height: 1.7;
}

.answer-input {
  width: 100%;

  min-height: 140rpx;

  box-sizing: border-box;

  margin-top: 20rpx;

  padding: 20rpx;

  background: #f7f8fa;

  border-radius: 18rpx;

  font-size: 28rpx;
}

.answer-button {
  margin-top: 20rpx;
}

.skip-button {
  margin-top: 12rpx;

  background: transparent;

  color: #777;

  font-size: 25rpx;
}


/* ==============================
   Actions
   ============================== */

.actions {
  margin-top: 34rpx;
}

.save-button {
  width: 100%;

  border-radius: 18rpx;

  font-size: 29rpx;
}

.reset-button {
  width: 100%;

  margin-top: 15rpx;

  background: #fff;

  color: #555;

  border: 1rpx solid #ddd;

  border-radius: 18rpx;

  font-size: 28rpx;
}


/* ==============================
   Saved
   ============================== */

.saved-tip {
  margin-top: 18rpx;

  text-align: center;

  color: #888;

  font-size: 23rpx;

  line-height: 1.6;
}


/* ==============================
   Footer
   ============================== */

.footer {
  margin-top: 70rpx;

  text-align: center;

  color: #aaa;

  font-size: 22rpx;

  line-height: 1.8;
}